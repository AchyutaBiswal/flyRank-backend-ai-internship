# =========================================================
# FlyRank Week 8 - Feedback Intelligence Platform
# Copy this file to ".env" and fill in your own local values.
# Never commit a real ".env" file with actual secrets.
# =========================================================

# --- Server ---
SERVER_PORT=8080

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/flyrank_feedback?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# --- JWT Authentication ---
# Use a long, random, secret string in real deployments (32+ characters).
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRATION_MS=86400000

# --- LLM Integration ---
# Works with any OpenAI-compatible chat completions endpoint.
# Leave LLM_API_KEY empty to automatically use the built-in rule-based
# fallback analyzer (no external key required for local demo/testing).
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=true

# --- Background Report Job ---
REPORTS_DIR=./reports
# Default: run once a day at 01:00
REPORTS_CRON=0 0 1 * * *
